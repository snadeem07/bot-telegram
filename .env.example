# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Webhook URL
# For App Engine: https://your-project-id.appspot.com
# For local development: use ngrok or similar tunneling service
WEBHOOK_URL=https://your-project-id.appspot.com

# Database Configuration
# For Cloud SQL (Production)
CLOUD_SQL_CONNECTION_NAME=project-id:region:instance-name
DB_NAME=expense_tracker
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# For Local Development (TCP Connection)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=expense_tracker
# DB_USER=postgres
# DB_PASSWORD=your_local_password

# Optional: Application Settings
PYTHON_ENV=development
PORT=8080

# Google Cloud Project Configuration
# GCP_PROJECT_ID=your-project-id
# GCP_REGION=us-central1
